<h2>Filter Options</h2>
<h3>Bands</h3>

<form>
    <select>
        <option value="">---Filter for Band---</option>
        <% bands.forEach(band => { %>
            <option value="<%= band %>"> <%= band %></option>
        <% }) %>
    </select>
</form>

<h3>Locations</h3>

<form>
    <select>
        <option value="">---Filter for Venue---</option>
        <% locations.forEach(location => { %>
            <option value="<%= location %>"> <%= location %></option>
        <% }) %>
    </select>
</form>

